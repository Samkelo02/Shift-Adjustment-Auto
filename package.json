{
  "name": "shift-adjustment-e2e",
  "version": "1.0.0",
  "description": "End-to-end tests for the Shift Adjustment application",
  "private": true,
  "scripts": {
    "auth": "node scripts/save-auth.js",
    "auth:admin": "node scripts/save-auth.js --role admin",
    "auth:initiator": "node scripts/save-auth.js --role initiator",
    "auth:approver": "node scripts/save-auth.js --role approver",
    "test": "playwright test",
    "test:admin": "playwright test --project=admin",
    "test:initiator": "playwright test --config=playwright.initiator.config.js",
    "test:approver": "playwright test --config=playwright.approver.config.js",
    "test:submission": "node scripts/run-submission-test.js",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:list": "playwright test --list",
    "report": "playwright show-report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.0"
  }
}
